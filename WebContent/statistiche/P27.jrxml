		<queryString language="plsql">
			<![CDATA[{ call PG_STATISTICHE.P27_01($P{UTENTE},$P{DATA_INIZIO}, $P{DATA_FINE}, $P{UFFICIO}, $P{ORACLE_REF_CURSOR}) }]]>
		</queryString>
		<field name="COL_UTENTE" class="java.lang.String"/>
		<field name="COL_ORDER" class="java.math.BigDecimal"/>
