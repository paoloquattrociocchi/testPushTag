		<parameter name="DS_UFFICIO" class="java.lang.Integer"/>
		<parameter name="DS_DATA_INIZIO" class="java.util.Date"/>
		<queryString language="plsql">
			<![CDATA[{ call T03_01($P{DS_DATA_INIZIO}, $P{DS_UFFICIO},  $P{ORACLE_REF_CURSOR}) }]]>
		</queryString>
		<field name="ANNO" class="java.lang.String"/>
		<field name="NUMERO" class="java.lang.Integer"/>
		<field name="P_PENDENTI" class="java.lang.String"/>
		<variable name="NUMERO2" class="java.lang.Number" calculation="Count">
			<variableExpression><![CDATA[$F{NUMERO}]]></variableExpression>
		</variable>
		<group name="TITOLO">
			<groupExpression><![CDATA[$F{ANNO}]]></groupExpression>
		</group>
	</subDataset>
