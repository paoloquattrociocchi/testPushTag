	<subDataset name="DatasetTitolo" uuid="57c56a22-a327-480a-b780-60724b3a8e41">
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="SMP_GIU2"/>
		<parameter name="DS_UFFICIO" class="java.lang.Integer"/>
		<queryString language="SQL">
			<![CDATA[select   
'Ufficio: '  ||
 "T_AN_UFFICIO"."DESC_UFFICIO" as TITOLO
from  "T_AN_UFFICIO" 
where  "T_AN_UFFICIO"."CODI_K_ID_UFFICIO" = $P{DS_UFFICIO}]]>
		</queryString>
		<field name="TITOLO" class="java.lang.String"/>
		<group name="TITOLO">
			<groupExpression><![CDATA[$F{TITOLO}]]></groupExpression>
		</group>
	</subDataset>
	<subDataset name="DataSet_P12" uuid="54ffe6ce-c94c-4371-92a0-46323b42de1d">
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="SMP2"/>
		<parameter name="DSDATA_INIZIO" class="java.util.Date"/>
		<parameter name="DSDATA_FINE" class="java.util.Date"/>
		<parameter name="DSUFFICIO" class="java.lang.Integer"/>
		<parameter name="DSMAGISTRATO" class="java.lang.Integer">
			<parameterDescription><![CDATA[]]></parameterDescription>
		</parameter>
		<queryString language="plsql">
			<![CDATA[{ call PG_STATISTICHE.P11($P{DSDATA_INIZIO}, $P{DSDATA_FINE}, $P{DSUFFICIO}, $P{DSMAGISTRATO},$P{ORACLE_REF_CURSOR}) }]]>
		</queryString>
		<field name="TOTALE" class="java.lang.Integer"/>
		<field name="TOT_PROPOSTE" class="java.lang.Integer"/>
		<field name="TOT_ARCHIVIA" class="java.lang.Integer"/>
		<field name="TOT_INCOMPET" class="java.lang.Integer"/>
		<field name="TOT_RIUNIONE" class="java.lang.Integer"/>
		<field name="TOT_ANNULLA" class="java.lang.Integer"/>
		<field name="TOT_IMPROCEDIB" class="java.lang.Integer"/>
	</subDataset>
	<subDataset name="Dataset_Magistrato" uuid="d72c88f7-643d-4e5c-988a-fa2da8434a8d">
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="SMP2"/>
		<parameter name="DSMAGISTRATO" class="java.lang.Integer"/>
		<queryString language="SQL">
			<![CDATA[select "T_AN_MAGISTRATI"."DESC_COGNOME_MAG" || ' ' || "T_AN_MAGISTRATI"."DESC_NOME_MAG" AS NOMEMAGISTRATO 
from "T_AN_MAGISTRATI" where "T_AN_MAGISTRATI"."CODI_K_ID_MAGISTRATO"= $P{DSMAGISTRATO}]]>
		</queryString>
		<field name="NOMEMAGISTRATO" class="java.lang.String"/>
	</subDataset>
	<parameter name="UFFICIO" class="java.lang.Integer">
		<parameterDescription><![CDATA[]]></parameterDescription>
		<defaultValueExpression><![CDATA[1419]]></defaultValueExpression>
	</parameter>
	<parameter name="DATA_INIZIO" class="java.util.Date">
		<defaultValueExpression><![CDATA[DATEFORMAT($P{DATA_INIZIO},"dd-mm-yyyy")]]></defaultValueExpression>
	</parameter>
	<parameter name="DATA_FINE" class="java.util.Date"/>
	<parameter name="ORACLE_REF_CURSOR" class="java.sql.ResultSet">
		<parameterDescription><![CDATA[]]></parameterDescription>
	</parameter>
	<parameter name="TOT_NEW" class="java.lang.Integer" isForPrompting="false">
		<parameterDescription><![CDATA[]]></parameterDescription>
	</parameter>
	<parameter name="MAGISTRATO" class="java.lang.Integer"/>
	<parameter name="totale" class="java.lang.Integer" isForPrompting="false"/>
	<queryString language="SQL">
		<![CDATA[select 1 as OnePage from DUAL]]>
	</queryString>
	<field name="OnePage" class="java.lang.String"/>
