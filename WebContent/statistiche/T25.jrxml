		<parameter name="UFFICIO" class="java.lang.Integer"/>
		<queryString language="SQL">
			<![CDATA[SELECT TRIM( UPPER( T_TP_TIPO_UFFICIO.DESC_TIPO_UFF)) AS DESC_TIPO_UFFICIO,
	"T_AN_COMUNI"."DESC_COMUNE",
	TRIM( UPPER( T_AN_UFFICIO.DESC_UFFICIO)) AS NEW_DESC_UFFICIO
FROM "T_AN_COMUNI",
	"T_AN_UFFICIO",
	"T_TP_TIPO_UFFICIO"
WHERE 
	 "T_AN_COMUNI"."CODI_K_ID_COMUNE" = "T_AN_UFFICIO"."CODI_FK_ID_COM_SEDE" 
	 AND "T_AN_UFFICIO"."CODI_FK_ID_TIPO_UFF" = "T_TP_TIPO_UFFICIO"."CODI_K_ID_TIPO_UFF" 
	 AND ( 
	 "T_AN_UFFICIO"."CODI_K_ID_UFFICIO" =$P{UFFICIO})]]>
		</queryString>
		<field name="DESC_TIPO_UFFICIO" class="java.lang.String"/>
		<field name="DESC_COMUNE" class="java.lang.String"/>
		<field name="NEW_DESC_UFFICIO" class="java.lang.String"/>
	</subDataset>
