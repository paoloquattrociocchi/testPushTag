		<parameter name="DS_DATA_INIZIO" class="java.util.Date"/>
		<queryString language="plsql">
			<![CDATA[{ call PG_STATISTICHE.C20_01($P{DS_DATA_INIZIO}, $P{DS_DATA_FINE}, $P{DS_UFFICIO},  $P{ORACLE_REF_CURSOR}) }]]>
		</queryString>
		<field name="DESC_CAT_ATTO" class="java.lang.String"/>
		<field name="COUNT" class="java.lang.Integer"/>
		<variable name="COUNT1" class="java.lang.Integer" calculation="Sum">
			<variableExpression><![CDATA[$F{COUNT}]]></variableExpression>
		</variable>
		<group name="TITOLO">
			<groupExpression><![CDATA[$F{DESC_CAT_ATTO}]]></groupExpression>
		</group>
	</subDataset>
