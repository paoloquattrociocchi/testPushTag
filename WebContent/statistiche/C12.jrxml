	<subDataset name="DatasetTitolo" uuid="1c94561d-a4a8-4daf-93bc-012b639c6a6e">
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="SMP2"/>
		<parameter name="DS_UFFICIO" class="java.lang.Integer"/>
		<queryString language="SQL">
			<![CDATA[SELECT TRIM( UPPER( T_TP_TIPO_UFFICIO.DESC_TIPO_UFF)) AS DESC_TIPO_UFFICIO,
	"T_AN_COMUNI"."DESC_COMUNE",
	TRIM( UPPER( T_AN_UFFICIO.DESC_UFFICIO)) AS NEW_DESC_UFFICIO 
FROM "T_AN_COMUNI",
	"T_AN_UFFICIO",
	"T_TP_TIPO_UFFICIO"
WHERE 
	 "T_AN_COMUNI"."CODI_K_ID_COMUNE" = "T_AN_UFFICIO"."CODI_FK_ID_COM_SEDE" 
	 AND "T_AN_UFFICIO"."CODI_FK_ID_TIPO_UFF" = "T_TP_TIPO_UFFICIO"."CODI_K_ID_TIPO_UFF" 
	 AND ( 
	 "T_AN_UFFICIO"."CODI_K_ID_UFFICIO" =$P{DS_UFFICIO})]]>
		</queryString>
		<field name="DESC_TIPO_UFFICIO" class="java.lang.String"/>
		<field name="DESC_COMUNE" class="java.lang.String"/>
		<field name="NEW_DESC_UFFICIO" class="java.lang.String"/>
	</subDataset>
	<parameter name="UFFICIO" class="java.lang.Integer"/>
	<parameter name="DATA_INIZIO" class="java.util.Date"/>
	<parameter name="DATA_FINE" class="java.util.Date"/>
	<parameter name="UTENTE" class="java.lang.String"/>
	<queryString language="plsql">
		<![CDATA[{   call PG_STATISTICHE.C12_01($P{UTENTE},$P{DATA_INIZIO}, $P{DATA_FINE}, $P{UFFICIO},  $P{ORACLE_REF_CURSOR}) }]]>
	</queryString>
