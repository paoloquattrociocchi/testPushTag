		<parameterDescription><![CDATA[]]></parameterDescription>
		<defaultValueExpression><![CDATA[1]]></defaultValueExpression>
	</parameter>
	<parameter name="UFFICIO" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[1410]]></defaultValueExpression>
	</parameter>
	<parameter name="DATA_INIZIO" class="java.util.Date"/>
	<parameter name="DATA_FINE" class="java.util.Date"/>
	<queryString language="plsql">
		<![CDATA[{ call PG_STATISTICHE.C28_01($P{UTENTE},$P{DATA_INIZIO},  $P{DATA_FINE}, $P{UFFICIO},  $P{ORACLE_REF_CURSOR}) }]]>
	</queryString>
