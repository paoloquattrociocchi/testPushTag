	<subDataset name="DatasetTitolo" uuid="57c56a22-a327-480a-b780-60724b3a8e41">
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="SMP_GIU2"/>
		<parameter name="DS_UFFICIO" class="java.lang.Integer"/>
		<queryString language="SQL">
			<![CDATA[select   
'Ufficio: '  ||
 "T_AN_UFFICIO"."DESC_UFFICIO" as TITOLO
from  "T_AN_UFFICIO" 
where  "T_AN_UFFICIO"."CODI_K_ID_UFFICIO" = $P{DS_UFFICIO}]]>
		</queryString>
		<field name="TITOLO" class="java.lang.String"/>
		<group name="TITOLO">
			<groupExpression><![CDATA[$F{TITOLO}]]></groupExpression>
		</group>
	</subDataset>
	<subDataset name="DatasetDati" uuid="b3c92bc4-457c-448d-9361-0dbfbb95af89">
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="SMP2"/>
		<parameter name="DS_DATA_FINE" class="java.util.Date"/>
		<parameter name="DS_UFFICIO" class="java.lang.Integer"/>
		<queryString language="plsql">
			<![CDATA[{ call PG_STATISTICHE.T05_01($P{DS_DATA_FINE}, $P{DS_UFFICIO},  $P{ORACLE_REF_CURSOR}) }]]>
		</queryString>
		<field name="ID_MAG" class="java.lang.Number"/>
		<field name="RUOLO" class="java.lang.String"/>
		<field name="COGNOME" class="java.lang.String"/>
		<field name="NOME" class="java.lang.String"/>
		<field name="NUMEROPRO" class="java.lang.Integer"/>
