		<![CDATA[{ call PG_STATISTICHE.PG04_01($P{UTENTE}, $P{DATA_INIZIO}, $P{DATA_FINE}, $P{UFFICIO},  $P{ORACLE_REF_CURSOR}) }]]>
	</queryString>
