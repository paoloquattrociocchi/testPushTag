	<subDataset name="DatasetTitolo" uuid="57c56a22-a327-480a-b780-60724b3a8e41">
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="SMP_GIU2"/>
		<parameter name="DS_UFFICIO" class="java.lang.Integer"/>
		<queryString language="SQL">
			<![CDATA[select   
'Ufficio: '  ||
 "T_AN_UFFICIO"."DESC_UFFICIO" as TITOLO
from  "T_AN_UFFICIO" 
where  "T_AN_UFFICIO"."CODI_K_ID_UFFICIO" = $P{DS_UFFICIO}]]>
		</queryString>
		<field name="TITOLO" class="java.lang.String"/>
		<group name="TITOLO">
			<groupExpression><![CDATA[$F{TITOLO}]]></groupExpression>
		</group>
	</subDataset>
	<parameter name="UFFICIO" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[1419]]></defaultValueExpression>
	</parameter>
	<parameter name="DATA_INIZIO" class="java.util.Date">
		<defaultValueExpression><![CDATA[$P{DATA_INIZIO}.getDate()]]></defaultValueExpression>
	</parameter>
	<parameter name="DATA_FINE" class="java.util.Date">
		<defaultValueExpression><![CDATA[$P{DATA_FINE}.getDate()]]></defaultValueExpression>
	</parameter>
	<parameter name="ORACLE_REF_CURSOR" class="java.sql.ResultSet">
		<parameterDescription><![CDATA[]]></parameterDescription>
	</parameter>
	<queryString language="plsql">
		<![CDATA[{ call PG_STATISTICHE.P05_01($P{DATA_INIZIO}, $P{DATA_FINE}, $P{UFFICIO},  $P{ORACLE_REF_CURSOR}) }]]>
	</queryString>
	<field name="MAGISTRATO" class="java.lang.String"/>
	<field name="PROPOSTA" class="java.math.BigDecimal"/>
	<field name="ARCHIVIAZIONE" class="java.math.BigDecimal"/>
	<field name="IMPROCEDIBILITA" class="java.math.BigDecimal">
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
	<field name="INCOMPETENZA" class="java.math.BigDecimal"/>
	<field name="RIUNIONE" class="java.math.BigDecimal"/>
	<field name="TOTALEDEFINITI" class="java.math.BigDecimal"/>
	<field name="ERROREANNULLAMENTI" class="java.math.BigDecimal"/>
	<field name="TOTALEREGISTRO" class="java.math.BigDecimal"/>
	<variable name="RecordCount" class="java.lang.Integer" calculation="Count">
		<initialValueExpression><![CDATA[0]]></initialValueExpression>
	</variable>
