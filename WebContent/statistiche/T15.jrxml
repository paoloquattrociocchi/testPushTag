	<subDataset name="DatasetTitolo" uuid="57c56a22-a327-480a-b780-60724b3a8e41">
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="SMP_GIU2"/>
		<parameter name="DS_UFFICIO" class="java.lang.Integer"/>
		<queryString language="SQL">
			<![CDATA[select   
'Ufficio: '  ||
 "T_AN_UFFICIO"."DESC_UFFICIO" as TITOLO
from  "T_AN_UFFICIO" 
where  "T_AN_UFFICIO"."CODI_K_ID_UFFICIO" = $P{DS_UFFICIO}]]>
		</queryString>
		<field name="TITOLO" class="java.lang.String"/>
		<group name="TITOLO">
			<groupExpression><![CDATA[$F{TITOLO}]]></groupExpression>
		</group>
	</subDataset>
	<subDataset name="DatasetdDati" uuid="4b99b6d2-1e8b-43a1-87c7-77e8ce618435">
		<parameter name="DS_DATA_INIZIO" class="java.util.Date"/>
		<parameter name="DS_DATA_FINE" class="java.util.Date"/>
		<parameter name="DS_UFFICIO" class="java.lang.Integer"/>
		<queryString language="plsql">
			<![CDATA[{ call PG_STATISTICHE.T15_02($P{DS_DATA_INIZIO}, $P{DS_DATA_FINE}, $P{DS_UFFICIO},  $P{ORACLE_REF_CURSOR}) }]]>
		</queryString>
		<field name="ACCOLTE" class="java.lang.Number"/>
		<field name="RIGETTATE" class="java.lang.Number"/>
		<field name="NON_VOLERSI_PROCEDERE" class="java.lang.Number"/>
		<field name="REVOCA" class="java.lang.Number"/>
		<variable name="Variable_1" class="java.lang.Number">
			<variableExpression><![CDATA[SUM($F{RIGETTATE},$F{REVOCA},$F{NON_VOLERSI_PROCEDERE},$F{ACCOLTE})]]></variableExpression>
		</variable>
	</subDataset>
	<parameter name="UFFICIO" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[$P{UFFICIO}]]></defaultValueExpression>
	</parameter>
	<parameter name="DATA_FINE" class="java.util.Date">
		<defaultValueExpression><![CDATA[$P{DATA_FINE}]]></defaultValueExpression>
	</parameter>
	<parameter name="DATA_INIZIO" class="java.util.Date">
		<defaultValueExpression><![CDATA[DATEFORMAT($P{DATA_INIZIO},"dd-mm-yyyy")]]></defaultValueExpression>
	</parameter>
	<parameter name="ORACLE_REF_CURSOR" class="java.sql.ResultSet"/>
	<queryString language="plsql">
		<![CDATA[{ call PG_STATISTICHE.T15_01($P{DATA_INIZIO}, $P{DATA_FINE}, $P{UFFICIO},  $P{ORACLE_REF_CURSOR}) }]]>
	</queryString>
	<field name="ACCOLTE" class="java.lang.Number"/>
	<field name="RIGETTATE" class="java.lang.Number"/>
	<field name="NON_VOLERSI_PROCEDERE" class="java.lang.Number"/>
