		<queryString language="plsql">
			<![CDATA[{ call PG_STATISTICHE.P23_02($P{DATA_INIZIO}, $P{DATA_FINE}, $P{UFFICIO}, $P{ORACLE_REF_CURSOR}) }]]>
		</queryString>
		<field name="MAGISTRATO" class="java.lang.String"/>
		<field name="TOTALERIGA" class="java.lang.Integer">
			<fieldDescription><![CDATA[]]></fieldDescription>
		</field>
	</subDataset>
