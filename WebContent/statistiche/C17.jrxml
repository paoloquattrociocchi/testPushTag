	<queryString language="plsql">
		<![CDATA[{ call PG_STATISTICHE.C17_01( $P{DATA_INIZIO}, $P{DATA_FINE}, $P{UFFICIO}, $P{ORACLE_REF_CURSOR}) }]]>
	</queryString>
