		<queryString language="plsql">
			<![CDATA[{ call PG_STATISTICHE.T26_01($P{DS_DATA_INIZIO}, $P{DS_DATA_FINE}, $P{DS_UFFICIO},  $P{ORACLE_REF_CURSOR}) }]]>
		</queryString>
		<field name="DESC_CAT_ATTO" class="java.lang.String"/>
		<field name="COUNT" class="java.lang.Integer"/>
		<group name="TITOLO">
