		<![CDATA[{ call PG_STATISTICHE.T23_01($P{DATA_INIZIO}, $P{DATA_FINE}, $P{UFFICIO},  $P{ORACLE_REF_CURSOR}) }]]>
	</queryString>
	<field name="NUMERO" class="java.lang.Integer"/>
	<field name="RELATORE" class="java.lang.String"/>
