	<subDataset name="DatasetTitolo" uuid="7a8350a3-a5b2-470b-a0b6-fc45b97484fb">
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="SMP2"/>
		<parameter name="UFFICIO" class="java.lang.Integer"/>
		<queryString language="plsql">
			<![CDATA[SELECT PG_STATISTICHE.TESTATA($P{UFFICIO})  AS NEW_DESC_UFFICIO FROM "DUAL" DUAL]]>
		</queryString>
		<field name="NEW_DESC_UFFICIO" class="java.lang.String"/>
	</subDataset>
	<parameter name="UFFICIO" class="java.lang.Integer"/>
	<parameter name="DATA_INIZIO" class="java.util.Date"/>
	<parameter name="DATA_FINE" class="java.util.Date"/>
	<parameter name="ORACLE_REF_CURSOR" class="java.sql.ResultSet" isForPrompting="false"/>
	<queryString language="SQL">
		<![CDATA[SELECT DISTINCT
  T_PROCEDIMENTO.nume_anno_proc    AS anno,
  T_PROCEDIMENTO.nume_proc AS numero
FROM
  T_PROCEDIMENTO,
  T_REL_ATTO_PROC,
  T_ATTO
WHERE
  T_PROCEDIMENTO.codi_fk_id_uff_owner    = T_REL_ATTO_PROC.CODI_K_ID_UFF_OWNER
AND T_PROCEDIMENTO.codi_k_id_proc        = T_REL_ATTO_PROC.codi_k_id_proc
AND T_REL_ATTO_PROC.CODI_K_ID_ATTO       = T_ATTO.codi_k_id_atto
AND T_REL_ATTO_PROC.CODI_K_ID_UFF_OWNER  = T_ATTO.CODI_K_ID_UFF_OWNER
AND T_ATTO.CODI_K_ID_UFF_OWNER           = $P{UFFICIO}
AND T_PROCEDIMENTO.CODI_FK_ID_UFF_OWNER  =$P{UFFICIO}
AND
  (
    T_ATTO.codi_fk_id_cat_atto IN (5, 7)
  )
AND T_PROCEDIMENTO.DATA_ISCRIZIONE BETWEEN $P{DATA_INIZIO} AND $P{DATA_FINE}
ORDER BY
  T_PROCEDIMENTO.nume_anno_proc,
  T_PROCEDIMENTO.nume_proc]]>
	</queryString>
	<field name="anno" class="java.lang.Integer"/>
	<field name="numero" class="java.lang.Integer"/>
	<variable name="numero1" class="java.lang.Integer" resetType="Group" resetGroup="GruppoAnno" calculation="DistinctCount">
		<variableExpression><![CDATA[$F{numero}]]></variableExpression>
	</variable>
	<variable name="NumTotProced" class="java.lang.Integer" incrementType="Group" incrementGroup="GruppoAnno" calculation="Sum">
		<variableExpression><![CDATA[$V{numero1}]]></variableExpression>
	</variable>
