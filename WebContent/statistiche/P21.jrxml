		<defaultValueExpression><![CDATA[1576]]></defaultValueExpression>
	</parameter>
	<parameter name="UTENTE" class="java.lang.String">
		<parameterDescription><![CDATA[]]></parameterDescription>
		<defaultValueExpression><![CDATA[1419]]></defaultValueExpression>
	</parameter>
	<queryString language="plsql">
		<![CDATA[{ call PG_STATISTICHE.P21_01($P{DATA_INIZIO}, $P{DATA_FINE}, $P{UFFICIO}, $P{MAGISTRATO}, $P{ORACLE_REF_CURSOR}) }]]>
	</queryString>
