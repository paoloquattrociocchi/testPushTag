	<subDataset name="DatasetTitolo" uuid="57c56a22-a327-480a-b780-60724b3a8e41">
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="SMP_GIU2"/>
		<parameter name="DS_UFFICIO" class="java.lang.Integer"/>
		<queryString language="SQL">
			<![CDATA[select   
'Ufficio: '  ||
 "T_AN_UFFICIO"."DESC_UFFICIO" as TITOLO
from  "T_AN_UFFICIO" 
where  "T_AN_UFFICIO"."CODI_K_ID_UFFICIO" = $P{DS_UFFICIO}]]>
		</queryString>
		<field name="TITOLO" class="java.lang.String"/>
		<group name="TITOLO">
			<groupExpression><![CDATA[$F{TITOLO}]]></groupExpression>
		</group>
	</subDataset>
	<parameter name="UFFICIO" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[58]]></defaultValueExpression>
	</parameter>
	<parameter name="DATA_FINE" class="java.util.Date"/>
	<parameter name="DATA_INIZIO" class="java.util.Date">
		<defaultValueExpression><![CDATA[DATEFORMAT($P{DATA_INIZIO},"dd-mm-yyyy")]]></defaultValueExpression>
	</parameter>
	<parameter name="ORACLE_REF_CURSOR" class="java.sql.ResultSet">
		<parameterDescription><![CDATA[]]></parameterDescription>
	</parameter>
	<queryString language="plsql">
		<![CDATA[{ call PG_STATISTICHE.T01_01($P{DATA_INIZIO}, $P{DATA_FINE}, $P{UFFICIO},$P{ORACLE_REF_CURSOR}) }]]>
	</queryString>
	<field name="TIPI_PROCEDIMENTI" class="java.lang.String"/>
	<field name="ORGANI_PROPONENTI" class="java.lang.String"/>
	<field name="PROCEDIMENTI_PENDENTI_PERIODO" class="java.lang.Double"/>
	<field name="PROCEDIMENTI_SOPRAV_PERIODO" class="java.lang.Double"/>
	<field name="PROCEDIMENTI_DEFINITI" class="java.lang.Double"/>
	<variable name="TOTALE" class="java.math.BigDecimal"/>
	<variable name="NUM_SOTTRAZ" class="java.math.BigDecimal"/>
	<variable name="SOTTRAZIONE" class="java.math.BigDecimal"/>
	<variable name="PEN" class="java.math.BigDecimal">
		<variableExpression><![CDATA[new BigDecimal($F{PROCEDIMENTI_PENDENTI_PERIODO})]]></variableExpression>
	</variable>
	<variable name="SOP" class="java.math.BigDecimal">
		<variableExpression><![CDATA[new BigDecimal($F{PROCEDIMENTI_SOPRAV_PERIODO})]]></variableExpression>
	</variable>
	<variable name="DEF" class="java.math.BigDecimal">
		<variableExpression><![CDATA[new BigDecimal($F{PROCEDIMENTI_DEFINITI})]]></variableExpression>
	</variable>
	<variable name="Variable_1" class="java.math.BigDecimal">
		<variableExpression><![CDATA[$V{SOP}.add($V{PEN}).subtract($V{DEF})]]></variableExpression>
	</variable>
