				<textElement textAlignment="Center">
					<font size="14" isBold="true"/>
				</textElement>
				<text><![CDATA[T01. Movimento procedimenti trattati per autorità proponente e tipo misura]]></text>
			</staticText>
			<textField>
				<reportElement x="1" y="40" width="801" height="20" uuid="eb7136cb-84bb-4eed-89d0-c4a244066888"/>
				<textElement textAlignment="Center">
