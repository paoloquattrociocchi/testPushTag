	<parameter name="P_URL_LOGO_MIN" class="java.lang.String"/>
	<parameter name="P_SUB_subreportMagistrati" class="net.sf.jasperreports.engine.JasperReport" isForPrompting="false"/>
	<parameter name="P_SUB_DATA_SOURCE_subreportMagistrati" class="net.sf.jasperreports.engine.JRDataSource" isForPrompting="false"/>
	<queryString>
		<![CDATA[SELECT DESC_SEDE_UFFICIO AS sedeUfficio FROM T_UFFICIO
WHERE CODI_FK_ID_TIPO_UFF = 19
AND DESC_SEDE_UFFICIO = 'BARCELLONA POZZO DI GOTTO']]>
	</queryString>
	<field name="atto.descTipoUfficio" class="java.lang.String"/>
	<field name="atto.descSedeUfficio" class="java.lang.String"/>
	<field name="dataSourceMagistrati" class="java.lang.Object"/>
	<field name="subreportMagistrati" class="java.lang.Object"/>
	<field name="dataSourceMispatrBeneSog" class="java.lang.Object"/>
	<field name="subreportMispatrBeneSog" class="java.lang.Object"/>
	<field name="atto.annoAtto" class="java.lang.Long"/>
	<field name="atto.numeroAtto" class="java.lang.Long"/>
	<title>
		<band height="389" splitType="Stretch">
			<image scaleImage="RetainShape" hAlign="Center" vAlign="Middle" onErrorType="Icon">
				<reportElement positionType="Float" x="0" y="0" width="525" height="70"/>
				<imageExpression><![CDATA[$P{P_URL_LOGO_MIN}]]></imageExpression>
			</image>
			<textField>
				<reportElement x="0" y="85" width="525" height="35"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font size="16" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{atto.descTipoUfficio}.toUpperCase()+" DI "+$F{atto.descSedeUfficio}]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="0" y="120" width="525" height="42"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font size="14" isBold="true" isUnderline="false"/>
				</textElement>
				<text><![CDATA[SEZIONE PER L'APPLICAZIONE DELLE MISURE DI PREVENZIONE]]></text>
			</staticText>
			<textField>
				<reportElement x="0" y="195" width="525" height="32"/>
				<textElement>
					<font size="12"/>
				</textElement>
				<textFieldExpression><![CDATA["Il "+ $F{atto.descTipoUfficio}+" di "+$F{atto.descSedeUfficio}+", sezione per l'applicazione delle misure di prevenzione, riunito in Camera di Consiglio, composto dai Magistrati :"]]></textFieldExpression>
			</textField>
			<subreport isUsingCache="false">
				<reportElement x="12" y="242" width="400" height="30"/>
				<dataSourceExpression><![CDATA[$F{dataSourceMagistrati}]]></dataSourceExpression>
				<subreportExpression><![CDATA[$F{subreportMagistrati}]]></subreportExpression>
			</subreport>
			<textField>
				<reportElement x="111" y="170" width="287" height="20"/>
				<textElement>
					<font size="12"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{atto.annoAtto} + "/" + $F{atto.numeroAtto}]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="12" y="170" width="99" height="20"/>
				<textElement>
					<font size="12" isBold="true"/>
				</textElement>
				<text><![CDATA[Decreto numero:]]></text>
			</staticText>
			<textField isStretchWithOverflow="true">
				<reportElement x="0" y="298" width="525" height="86"/>
				<textElement>
					<font size="12"/>
				</textElement>
				<textFieldExpression><![CDATA["riunito in camera di consiglio per deliberare sulla proposta della Procura della Repubblica presso il " + $F{atto.descTipoUfficio} + " di " + $F{atto.descSedeUfficio}.substring(0,1).toUpperCase()+$F{atto.descSedeUfficio}.substring(1).toLowerCase() + " del 23/10/2012 con la quale si chiede l'integrazione del sequestro dei beni, in funzione della successiva confisca nei confronti di "]]></textFieldExpression>
			</textField>
		</band>
	</title>
	<detail>
		<band height="104" splitType="Stretch">
			<subreport>
				<reportElement x="0" y="0" width="525" height="104"/>
				<dataSourceExpression><![CDATA[$F{dataSourceMispatrBeneSog}]]></dataSourceExpression>
				<subreportExpression><![CDATA[$F{subreportMispatrBeneSog}]]></subreportExpression>
			</subreport>
		</band>
	</detail>
	<pageFooter>
		<band height="54" splitType="Stretch">
