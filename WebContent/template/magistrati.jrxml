<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="subreportMagistrati" language="groovy" pageWidth="400" pageHeight="802" columnWidth="400" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<field name="cognome" class="java.lang.String"/>
	<field name="nome" class="java.lang.String"/>
	<field name="ruolo" class="java.lang.String"/>
	<background>
		<band splitType="Stretch"/>
	</background>
	<detail>
		<band height="20" splitType="Stretch">
			<textField>
				<reportElement x="13" y="0" width="244" height="20"/>
				<textElement>
					<font size="10"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{cognome} + " " + $F{nome}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="0" y="0" width="13" height="20"/>
				<textElement>
					<font size="10"/>
				</textElement>
				<textFieldExpression><![CDATA[$V{REPORT_COUNT} + ")"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="257" y="0" width="143" height="20"/>
				<textElement textAlignment="Right">
					<font size="10"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{ruolo}]]></textFieldExpression>
			</textField>
		</band>
	</detail>
</jasperReport>
