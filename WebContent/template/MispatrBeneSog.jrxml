					<textFieldExpression><![CDATA[$F{COGNOME_INTERESSATO} + " " + $F{NOME_INTERESSATO}.substring(0,1).toUpperCase()+ $F{NOME_INTERESSATO}.substring(1).toLowerCase() +
" nato/a a " + $F{DESC_COMUNE_NASC_INTERESSATO} + " (" + $F{SIGLA_PROV_NASC_INTERESSATO} + ") il " + $F{DATA_NASCITA_INTERESSATO}]]></textFieldExpression>
