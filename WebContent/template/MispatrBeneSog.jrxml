	<group name="gruppoSoggetto">
		<groupExpression><![CDATA[$F{ID_SOGGETTO_INTERESSATO}]]></groupExpression>
		<groupHeader>
			<band height="95">
				<textField isStretchWithOverflow="true">
					<reportElement x="0" y="0" width="525" height="20" isRemoveLineWhenBlank="true">
						<printWhenExpression><![CDATA[$F{TIPO_PERSONA_INTERESSATO}.equals( "F" )]]></printWhenExpression>
					</reportElement>
					<textElement>
						<font size="10" isBold="false"/>
