<?xml version="1.0" encoding="UTF-8"?><xs:schema attributeFormDefault="unqualified" elementFormDefault="qualified" targetNamespace="http://fug.type.ws.mg.it/basetypes" xmlns:tb="http://fug.type.ws.mg.it/basetypes" xmlns:xs="http://www.w3.org/2001/XMLSchema">
	<!--tipi numerici-->
	<xs:simpleType name="numerico">
		<xs:annotation>
			<xs:documentation>numerico di qualsiasi lunghezza </xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:whiteSpace value="collapse"/>
