	<!-- Date -->
	<xs:simpleType name="DataOraStruct">
		<xs:annotation>
			<xs:documentation>Accetta date nel formato GG/MM/AAAA-hh:mm:ss</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:pattern value="(((0[1-9]|[12][0-9]|3[01])/(0[1-9]|1[012])/(19|20)\d\d)-(([01][0-9]|2[0-3]):([0-5][0-9]):([0-5][0-9])))"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="Data">
		<xs:restriction base="xs:string">
			<xs:pattern value="(((0[1-9]|[12][0-9]|3[01])(0[1-9]|1[012])(19|20)\d\d))"/>
			<!-- Accetta date nel formato GGMMAAAA   -->
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="Anno">
		<xs:restriction base="xs:string">
			<xs:pattern value="((19|20)\d\d)"/>
			<!-- Accetta numeri di 4 cifre >=1900 e <= 2099  -->
		</xs:restriction>
	</xs:simpleType>
