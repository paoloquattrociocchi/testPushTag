<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">
  <xs:element name="messaggio">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="codicemessaggio"/>
        <xs:element ref="messagebody"/>
        <xs:element ref="esito"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="codicemessaggio" type="xs:integer"/>
  <xs:element name="messagebody" type="xs:string"/>
  <xs:element name="esito" type="xs:boolean"/>
</xs:schema>
