<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
	elementFormDefault="qualified">
	<xs:include schemaLocation="autenticazione.xsd"></xs:include>
	<xs:element name="firma">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="autenticazione" />
				<xs:element ref="codicefascicolo" minOccurs="1"
					maxOccurs="1" />
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="codicefascicolo" nillable="false">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:minLength value="1"></xs:minLength>
				<xs:maxLength value="2048"></xs:maxLength>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
</xs:schema>
