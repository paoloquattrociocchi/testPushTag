<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
"-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping>

	<sql-query name="PG_POLIZIA_inserisci_Messaggio" callable="true">
		<return-scalar column="IDSER" type="long"/>		
		{ call PG_POLIZIA.inserisci_dati_servizi_polizia(?, :IDAUTORITA, :VIDUFFICIO, :VIDTIPOSERV, :VIDPROC, :VXML, :VIDATTO, :VSTATO, :VERRORE, :VUTENTE, :VIDCATATTO) }
 	</sql-query>
 	
 	<sql-query name="PG_POLIZIA_getListaAttiDaProcedenti" callable="true" >
 	<return alias="att" class="it.giustizia.smp.model.TAtto"/>
		{ call PG_POLIZIA.GET_LISTA_ATTI_DA_PROCEDENTI (?) }
	</sql-query>
	
	<sql-query callable="true" name="PG_POLIZIA_flussi_polizia">
		{ call PG_POLIZIA.FLUSSI_POLIZIA(?,:vidUffOwn,:vflgDirezione) }
	</sql-query>
	
	<sql-query name="PG_POLIZIA_getMsgDaInviare" callable="true" >
	<return alias="pol" class="it.giustizia.smp.model.TPoliziaMsg"/>
		{ call PG_POLIZIA.GET_MSG_DA_INVIARE (?) }
	</sql-query>
	
	<sql-query callable="true" name="PG_POLIZIA_getTRelProcSogintList">
	<return alias="psi" class="it.giustizia.smp.model.TRelProcSogint"/>
		{ call PG_POLIZIA.GET_T_REL_PROC_SOGINT(?,:ID_PROC,:ID_UFF_OWNER) }
	</sql-query>
	
	<sql-query name="PG_POLIZIA_aggiornaStatoMsg" callable="true" >
		<return-scalar column="STATOUPDATE" type="string"/>
		{ call PG_POLIZIA.SET_STATO_MSG(?,:id_mess,:numestato,:DESCRERRORE) }
	</sql-query> 
	
	<sql-query name="PG_POLIZIA_get_flusso_polizia_by_id" callable="true" >
		<return alias="pol" class="it.giustizia.smp.model.TPoliziaMsg"/>
		{ call PG_POLIZIA.GET_FLUSSO_POLIZIA_BY_ID(?,:id_mes) }
	</sql-query>
	
	<!-- idServizio 17 -->
	<sql-query name="PG_POLIZIA_inserisci_fascicolo_indagine" callable="true" >
		<return-scalar column="STATO" type="string"/>
		{ call PG_POLIZIA.inserisci_fascicolo_indagine(?,:vidMsg,:vidUfficio,:vidProcedimento,:vidAutorita,:vdataEmissione,:vdescrNote) }
	</sql-query>
	
	<!-- idServizio 18 -->
	<sql-query name="PG_POLIZIA_esito_indagini" callable="true" >
