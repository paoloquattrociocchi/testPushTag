	</sql-query>
	
	<!-- idServizio 22 -->
	<sql-query name="PG_POLIZIA_violazione_sott_mis_pers" callable="true" >
		<return-scalar column="STATO" type="string"/>
		{ call PG_POLIZIA.VIOLAZ_SOTTOPOS_MIS_PERS(?,:vidMsg,:vidUfficio,:vidProcedimento,:vidAutorita,:vdataEmissione,:vdescrNote) }
	</sql-query>
	
	<!-- idServizio 23 -->
	<sql-query name="PG_POLIZIA_aggravamento_mis_pers" callable="true" >
