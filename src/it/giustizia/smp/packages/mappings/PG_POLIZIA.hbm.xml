	<sql-query name="PG_POLIZIA_GET_UFFICIO_DESTINATARIO" callable="true" >
		{ call PG_POLIZIA.GET_UFFICIO_DESTINATARIO (?,:IDUFFOWNER,:IDPROCEDIMENTO,:IDPROCEDENTE,:TIPOPROCEDIMENTO)}
	</sql-query>

	<sql-query name="PG_POLIZIA_inserisciDocumentoAllegatoAtto" callable="true" >
		{ call PG_POLIZIA.ins_doc_attegato_atto(?,:IDPROCEMISS,:IDATTO,:IDUFFOWN,:TIPODOCUMENTO,:NOMEDOCUMENTO,:DOCUMENTO) }
    </sql-query>
    
</hibernate-mapping>