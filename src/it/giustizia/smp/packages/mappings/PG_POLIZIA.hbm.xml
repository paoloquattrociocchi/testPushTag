		{ call PG_POLIZIA.ESITO_INDAGINI(?,:vidMsg,:vidUfficio,:vidProcedimento,:vidAutorita,:vdataEmissione,:vdescrNote) }
	</sql-query>
	
	<!-- idServizio 19 -->
	<sql-query name="PG_POLIZIA_proposta_misure_patr_pers" callable="true" >
		<return-scalar column="STATO" type="string"/>
		{ call PG_POLIZIA.proposta_misure_patr_pers(?,:vidMsg,:vidUfficio,:vidAutorita,:vdescrNumAccert,:vdataEmissione,:vdescrNote) }
	</sql-query>
	
	<!-- idServizio 20 -->
	<sql-query name="PG_POLIZIA_stato_sottopos_mis_pers" callable="true" >
		<return-scalar column="STATO" type="string"/>
		{ call PG_POLIZIA.SOTTOPOS_MIS_PERS(?,:vidMsg,:vidUfficio,:vidProcedimento,:vidAutorita,:vdataEmissione,:vdescrNote) }
	</sql-query>
	
	<!-- idServizio 21 -->
	<sql-query name="PG_POLIZIA_apll_mis_sic_lib_vig" callable="true" >
