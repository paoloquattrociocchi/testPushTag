<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
"-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping> 
	<sql-query name="PG_NOTIFICHE.IS_ATTO_INVIABILE" callable="true" >
		{ call PG_NOTIFICHE.IS_ATTO_INVIABILE(?,:CODI_K_ID_ATTO_PARAM,:CODI_K_ID_PROC_PARAM) }	
	</sql-query>
	
	<sql-query name="PG_NOTIFICHE.HAS_NOTIFICHE" callable="true" >
		{ call PG_NOTIFICHE.HAS_NOTIFICHE(?,:CODI_K_ID_ATTO_PARAM,:CODI_K_ID_UFFICIO_PARAM) }	
	</sql-query>  
	
	<sql-query name="PG_NOTIFICHE.CARICA_DESTINATARI_ATTO" callable="true" >
		{ call PG_NOTIFICHE.CARICA_DESTINATARI_ATTO(?,:CODI_K_ID_PROC_PARAM,:CODI_K_ID_ATTO_PARAM,:CODI_K_ID_UFFICIO) }	
	</sql-query>
	
	<sql-query name="PG_NOTIFICHE.CARICA_DESTINATARIO" callable="true" >
		{ call PG_NOTIFICHE.CARICA_DESTINATARIO(?, :CODI_K_ID_UFFICIO) }	
	</sql-query>
	
	<sql-query name="PG_NOTIFICHE.UPDATE_COPIA_PDOC" callable="true" >
		{ call PG_NOTIFICHE.UPDATE_COPIA_PDOC(?, :NUMCOPIAPDOC,:CODI_K_ID_ATTO_PARAM,:CODI_K_ID_UFFICIO) }	
	</sql-query>
	
	<sql-query name="PG_NOTIFICHE.INSERIMENTO_NOTIFICA" callable="true" >
		{ call PG_NOTIFICHE.INSERIMENTO_NOTIFICA(?, :CODI_FK_ID_ATTO_PARAM, :CODI_FK_ID_UFFICIO, :FLG_DATI_SENSIBILI_PARAM, :DESC_OGGETTO_PARAM, :DESC_EVENTO_PARAM, :DESC_UTENTE_PARAM, :DATA_INVIO_PARAM) }
	</sql-query>
	
	<sql-query name="PG_NOTIFICHE.INSERT_IN_NOTIF_RICHIESTE" callable="true" >
		{ call PG_NOTIFICHE.INSERT_IN_NOTIF_RICHIESTE(?, :CODI_FK_ID_NOTIFICA_PARAM, :FLG_ALLEGA_CONT_PARAM, :XML_RICHIESTA_PARAM, :XML_RISPOSTA_PARAM) }
	</sql-query>
	
	<sql-query name="PG_NOTIFICHE.INSERT_IN_NOTIF_DEST" callable="true" >
		{ call PG_NOTIFICHE.INSERT_IN_NOTIF_DEST(?, :CODI_FK_ID_NOTIF_RICHIESTA, :CODI_FK_RUOLO_DEST, :DESC_DESTINATARO, :DESC_CODI_DEST ,  :DESC_CODI_TRASMISSIONE , :DESC_PEC_DEST, :DESC_ECCEZIONE , :DESC_UTENTE , :DATA_ULT_AGG) }
	</sql-query>


	<sql-query name="PG_NOTIFICHE.INSERISCI_ATTO_RICEVUTA" callable="true" >
		{ call PG_NOTIFICHE.INSERISCI_ATTO_RICEVUTA(?, :IDUFFOWN_PARAM, :ID_CAT_ATTO_PARAM, :DESCUTENTE_PARAM, :ID_PROCEDIMENTO_PARAM ,  :ID_NOTIF_DEST_PARAM , :CODI_K_STATO_TRASM_PARAM , :DOCUMENTO_PARAM, :TIPO_DOC_PARAM ) }
	</sql-query>
	
	<sql-query name="PG_NOTIFICHE.INSERISCI_ATTO_RAPP_TRASM" callable="true" >
		{ call PG_NOTIFICHE.INSERISCI_ATTO_RAPP_TRASM(?, :IDUFFOWN_PARAM, :ID_CAT_ATTO_PARAM, :DESCUTENTE_PARAM, :ID_PROCEDIMENTO_PARAM ,  :ID_NOTIF_DEST_PARAM , :ID_PDOC_TRASMISSIONE ) }
	</sql-query>
	
	<sql-query name="PG_NOTIFICHE.INSERT_IN_DEPOSITI_AMM" callable="true" >
		{ call PG_NOTIFICHE.INSERT_IN_DEPOSITI_AMM(?, :CODI_K_ID_DEPOSITO_AMM, :CODI_FK_ID_PROC_FG, :CODI_FK_ID_PROC, :XML_TOOL_AMM, :PDF_TOOL_AMM, :DESC_TIPO_DOCUMENTO, :DESC_NOME_DOCUMENTO) }
	</sql-query>

		
</hibernate-mapping>